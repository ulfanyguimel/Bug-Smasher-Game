canvas {
    background: url("kitchen.jpg");
  }
  
  body {
    margin: 0;
    padding: 0;
    text-align: center;
    font-family: 'Press Start 2P', cursive;
    background-color: #000;
    color: #fff;
  }
  
  nav {
    background-color: #333;
    color: white;
    height: 60px;
    display: flex;
    justify-content: center;
    align-items: center;
  }
  
  nav h1 {
    margin: 0;
    font-size: 30px;
  }
  
  .container {
    display: flex;
    justify-content: center;
    align-items: center;
    height: 100vh;
  }
  
  .game-wrapper {
    display: flex;
    flex-direction: column;
    justify-content: center;
    align-items: center;
    margin-right: 50px;
  }
  
  #gameCanvas {
    display: block;
    margin: auto;
    border: 2px solid #fff;
    background-color: #222;
    box-shadow: 0 0 10px #fff;
  }
  
  #score-container {
    display: inline-block;
    background-color: #4CAF50;
    color: white;
    font-size: 24px;
    font-weight: bold;
    padding: 10px;
    border-radius: 15px;
    margin-top: 20px;
    box-shadow: 0 0 10px #fff;
  }
  
  .button-wrapper {
    display: flex;
    flex-direction: column;
    justify-content: center;
    align-items: flex-end;
  }
  
  button {
    background-color: #4CAF50;
    color: white;
    border: none;
    border-radius: 15px;
    font-size: 24px;
    padding: 10px 20px;
    margin: 10px;
    cursor: pointer;
    font-family: 'Press Start 2P', cursive;
    box-shadow: 0 0 10px #fff;
  }
  
  button:hover {
    background-color: #3e8e41;
  }
  
